
<!DOCTYPE html>
<html>
<head>
    <title>Matching Card Game</title>

    <style>
        body {
            font-family: sans-serif;
            text-align: center;
            background: linear-gradient(to right, purple, blue, indigo);
            color: white;
        }

        #board {
            display: grid;
            grid-template-columns: repeat(4, 100px);
            gap: 10px;
            justify-content: center;
            margin: 30px auto;
        }

        .card {
            height: 100px;
            background: linear-gradient(to right, purple, blue);
            border: 2px solid white;
            border-radius: 10px;
            font-size: 35px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
        }

        button {
            padding: 15px 25px;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            cursor: pointer;
        }
    </style>
</head>

<body>

    <h1>Tutorial Level</h1>
    <p>Find the matching cards!</p>

    <p>Time: <span id="timer">0</span> seconds</p>

    <div id="board"></div>

    <h2 id="message"></h2>

    <button onclick="startGame()">Restart</button>

    <script>

        let emojis = ["❤️", "❤️", "😍", "😍",
                      "👍", "👍", "🙌", "🙌"];

        let firstCard = null;
        let secondCard = null;
        let matched = 0;
        let seconds = 0;
        let lock = false;
        let timer;

        function startGame() {

            clearInterval(timer);

            seconds = 0;
            matched = 0;
            firstCard = null;
            secondCard = null;
            lock = false;

            document.getElementById("timer").textContent = 0;
            document.getElementById("message").textContent = "";

            let board = document.getElementById("board");

            board.innerHTML = "";

            let cards = [...emojis];

            cards.sort(() => Math.random() - 0.5);

            cards.forEach(function(emoji) {

                let card = document.createElement("div");

                card.className = "card";
                card.textContent = "?";
                card.dataset.emoji = emoji;

                card.onclick = function() {
                    flipCard(card);
                };

                board.appendChild(card);

            });

            timer = setInterval(function() {
                seconds++;
                document.getElementById("timer").textContent = seconds;
            }, 1000);
        }

        function flipCard(card) {

            if (lock || card.textContent != "?") {
                return;
            }

            card.textContent = card.dataset.emoji;

            if (firstCard == null) {

                firstCard = card;

            } else {

                secondCard = card;
                lock = true;

                if (firstCard.dataset.emoji == secondCard.dataset.emoji) {

                    matched = matched + 2;

                    firstCard = null;
                    secondCard = null;
                    lock = false;

                    if (matched == emojis.length) {

                        clearInterval(timer);

                        document.getElementById("message").textContent =
                            "Congratulations! You won in " + seconds + " seconds!";

                    }

                } else {

                    setTimeout(function() {

                        firstCard.textContent = "?";
                        secondCard.textContent = "?";

                        firstCard = null;
                        secondCard = null;
                        lock = false;

                    }, 800);

                }
            }
        }

        startGame();

    </script>

</body>
</html>

